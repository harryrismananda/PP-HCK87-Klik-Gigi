<!DOCTYPE html>
<html lang="en">
  <%- include('./partial/_head', {title: "Register"}) %>
  <body class="bg-stone-400 min-h-screen">
    <div class="flex justify-center items-center">
      <!-- Register -->
      <div class="card w-96 bg-base-100 shadow-xl mx-auto py-10 my-10">
        <div class="card-body">
          <h2 class="card-title justify-center">Register</h2>

          <form
            action="/user/register"
            method="POST"
            class="form-control space-y-4"
          >
            <div>
              <label class="label">
                <span class="label-text">Full Name</span>
              </label>
              <input
                type="text"
                name="name"
                placeholder="Enter your full name"
                class="input input-bordered w-full"
              />
              <% if (error) { %>
                <% error = error.split(",") %>
            <p class="text-red-500"><%= error[0] %></p>
            <% } %>
            </div>

            <div>
              <label class="label">
                <span class="label-text">Email</span>
              </label>
              <input
                type="email"
                name="email"
                placeholder="Enter your email"
                class="input input-bordered w-full"
              />
              <% if (error) { %>
            <p class="text-red-500"><%= error[2] %></p>
            <% } %>
            </div>

            <div>
              <label class="label">
                <span class="label-text">Password</span>
              </label>
              <input
                type="password"
                name="password"
                placeholder="Enter your password"
                class="input input-bordered w-full"
              />
              
            </div>

            <div>
              <label class="label">
                <span class="label-text">Confirm Password</span>
              </label>
              <input
                type="password"
                name="confirmPassword"
                placeholder="Confirm your password"
                class="input input-bordered w-full"
                required
              />
              <% if (error) { %>
            <p class="text-red-500"><%= error[1] %></p>
            <% } %>
            </div>
            <button type="submit" class="btn btn-primary w-full">
              Register
            </button>
          </form>

          <p class="text-center mt-4 text-sm">
            Already have an account?
            <a href="/user/login" class="link link-primary">Login</a>
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
