<!DOCTYPE html>
<html lang="en">
  <%- include('./partial/_head', {title: "Register"}) %>
  <body class="bg-gray-100 min-h-screen flex justify-center items-center">
    <div class="card w-96 bg-white shadow-lg rounded-2xl mx-auto py-10 px-6">
      <div class="card-body">
        <h2 class="card-title justify-center text-2xl font-semibold text-gray-800">Register</h2>

        <form
          action="/user/register"
          method="POST"
          class="form-control space-y-4 mt-4"
        >
          <div>
            <label class="label">
              <span class="label-text text-gray-700">Full Name</span>
            </label>
            <input
              type="text"
              name="name"
              placeholder="Enter your full name"
              class="input w-full bg-gray-50 text-gray-900 placeholder-gray-400 rounded-xl border border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-400 focus:outline-none transition"
            />
            <% if (error) { %>
              <% error = error.split(",") %>
              <p class="text-red-500 text-sm mt-1"><%= error[0] %></p>
            <% } %>
          </div>

          <div>
            <label class="label">
              <span class="label-text text-gray-700">Email</span>
            </label>
            <input
              type="email"
              name="email"
              placeholder="Enter your email"
              class="input w-full bg-gray-50 text-gray-900 placeholder-gray-400 rounded-xl border border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-400 focus:outline-none transition"
            />
            <% if (error) { %>
              <p class="text-red-500 text-sm mt-1"><%= error[2] %></p>
            <% } %>
          </div>

          <div>
            <label class="label">
              <span class="label-text text-gray-700">Password</span>
            </label>
            <input
              type="password"
              name="password"
              placeholder="Enter your password"
              class="input w-full bg-gray-50 text-gray-900 placeholder-gray-400 rounded-xl border border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-400 focus:outline-none transition"
            />
          </div>

          <div>
            <label class="label">
              <span class="label-text text-gray-700">Confirm Password</span>
            </label>
            <input
              type="password"
              name="confirmPassword"
              placeholder="Confirm your password"
              class="input w-full bg-gray-50 text-gray-900 placeholder-gray-400 rounded-xl border border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-400 focus:outline-none transition"
              
            />
            <% if (error) { %>
              <p class="text-red-500 text-sm mt-1"><%= error[1] %></p>
            <% } %>
          </div>

          <button type="submit" class="btn btn-primary w-full">Register</button>
        </form>

        <p class="text-center mt-6 text-sm text-gray-700">
          Already have an account?
          <a href="/user/login" class="link link-primary font-medium">Login</a>
        </p>
      </div>
    </div>
  </body>
</html>
