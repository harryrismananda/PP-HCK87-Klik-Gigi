<!DOCTYPE html>
<html lang="en">
  <%- include('./partial/_head', {title: "New Appointment"}) %> <%-
  include('./partial/_nav') %>
  <body
    class="bg-gradient-to-b from-sky-50 to-sky-100 min-h-screen flex flex-col text-gray-800"
  >
    <div class="flex flex-1 justify-center items-center px-4 py-10">
      <div class="w-full max-w-2xl bg-white shadow-lg rounded-2xl p-8">
        <h2 class="text-3xl font-bold text-center text-sky-800 mb-8">
          Create Appointment
        </h2>

        <form
          action="/patient/<%= user.id %>/NewAppointment"
          method="POST"
          class="space-y-6"
        >

          <div class="form-control">
            <label class="label">
              <span class="label-text font-semibold text-sky-700"
                >Select Doctor</span
              >
            </label>
            <select name="DoctorId" class="select select-bordered w-full rounded-lg focus:ring-2 focus:ring-primary input  bg-gray-50 text-gray-900 placeholder-gray-400  border border-gray-300 focus:border-blue-500  focus:ring-blue-400 focus:outline-none transition">
              <option selected disabled>Choose your Doctor</option>
              <% doctors.forEach(doctor => { %>
              <option value="<%= doctor.id %>">
                <%= doctor.User.name %> - <%= doctor.specialization %>
              </option>
              <% }) %>
            </select>
            <% if (error) { %> <% error = error.split(",") %>
            <p class="text-red-500 text-sm mt-1"><%= error[0] %></p>
            <% } %>
          </div>


          <div class="form-control">
            <label class="label">
              <span class="label-text font-semibold text-sky-700">Appointment Date</span>
            </label>
            <input
              type="date"
              name="scheduledAt"
              class="input input-bordered w-full rounded-lg focus:ring-2 focus:ring-primary input  bg-gray-200 text-gray-900 placeholder-gray-400  border border-gray-300 focus:border-blue-500  focus:ring-blue-400 focus:outline-none transition"
            />
            <% if (error) { %>
            <p class="text-red-500 text-sm mt-1"><%= error[1] %></p>
            <% } %>
          </div>


          <div class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition p-8">
            <label class="label">
              <span
                class="label-text font-semibold text-sky-700"
                >Symptoms</span
              >
            </label>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <% symptoms.forEach(symptom => { %>
              <label
                class="flex items-center space-x-2 p-3 border border-gray-200 rounded-lg cursor-pointer hover:bg-blue-50 transition"
              >
                <input
                  type="checkbox"
                  name="SymptomId"
                  value="<%= symptom.id %>"
                  class="checkbox checkbox-primary"
                />
                <span class="text-gray-800"
                  ><%= symptom.name %></span
                >
              </label>
              <% }) %>
            </div>
            <% if (error) { %>
            <p class="text-red-500 text-sm mt-1"><%= error[2] %></p>
            <% } %>
          </div>


          <div class="form-control">
            <label class="block text-gray-700 font-semibold mb-2">
              <span class="label-text font-semibold text-sky-700"
                >Additional Notes (Optional)</span
              >
            </label>
            <textarea
              name="notes"
              class="textarea textarea-bordered w-full rounded-lg p-3 text-sm bg-gray-50 text-dark"
              rows="3"
              placeholder="Describe your condition..."
            ></textarea>
          </div>


          <div class="form-control pt-4">
            <button
              type="submit"
              class="btn btn-primary w-full rounded-full shadow-md hover:shadow-lg transition"
            >
              Book Appointment
            </button>
          </div>
        </form>
      </div>
    </div>

    <%- include('./partial/_footer') %>
  </body>
</html>
