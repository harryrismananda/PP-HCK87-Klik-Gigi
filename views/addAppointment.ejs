<!DOCTYPE html>
<html lang="en">
  <%- include('./partial/_head', {title: "New Appointment"}) %> <%-
  include('./partial/_nav') %>
  <body
    class="bg-gradient-to-b from-sky-50 to-sky-100 min-h-screen flex flex-col"
  >
    <div class="flex flex-1 justify-center items-center px-4 py-10">
      <div class="w-full max-w-2xl bg-white shadow-lg rounded-2xl p-8">
        <h2 class="text-3xl font-bold text-center text-sky-800 mb-8">
          Create Appointment
        </h2>

        <form
          action="/patient/<%= user.id %>/NewAppointment"
          method="POST"
          class="space-y-6"
        >
          <!-- Doctor Selection -->
          <div class="form-control">
            <label class="label">
              <span class="label-text font-semibold text-sky-700"
                >Select Doctor</span
              >
            </label>
            <select name="DoctorId" class="select select-bordered w-full">
              <option selected disabled>Choose your Doctor</option>
              <% doctors.forEach(doctor => { %>
              <option value="<%= doctor.id %>">
                <%= doctor.User.name %> - <%= doctor.specialization %>
              </option>
              <% }) %>
            </select>
            <% if (error) { %> <% error = error.split(",") %>
            <p class="text-red-500 text-sm mt-1"><%= error[0] %></p>
            <% } %>
          </div>

          <!-- Date -->
          <div class="form-control">
            <label class="label">
              <span class="label-text font-semibold text-sky-700">Date</span>
            </label>
            <input
              type="date"
              name="scheduledAt"
              class="input input-bordered w-full"
            />
            <% if (error) { %>
            <p class="text-red-500 text-sm mt-1"><%= error[1] %></p>
            <% } %>
          </div>

          <!-- Symptoms (checkboxes) -->
          <!-- Symptoms (checkboxes) -->
          <div class="form-control">
            <label class="label">
              <span
                class="label-text font-semibold text-sky-700"
                >Symptoms</span
              >
            </label>
            <div class="grid grid-cols-2 gap-3">
              <% symptoms.forEach(symptom => { %>
              <label
                class="cursor-pointer flex items-center space-x-2 bg-sky-50 dark:bg-slate-700 rounded-lg px-3 py-2 shadow-sm hover:bg-sky-100 dark:hover:bg-slate-600 transition"
              >
                <input
                  type="checkbox"
                  name="SymptomId"
                  value="<%= symptom.id %>"
                  class="checkbox checkbox-primary"
                />
                <span class="text-gray-800 dark:text-gray-200"
                  ><%= symptom.name %></span
                >
              </label>
              <% }) %>
            </div>
            <% if (error) { %>
            <p class="text-red-500 text-sm mt-1"><%= error[2] %></p>
            <% } %>
          </div>

          <!-- Notes -->
          <div class="form-control">
            <label class="label">
              <span class="label-text font-semibold text-sky-700"
                >Additional Notes (Optional)</span
              >
            </label>
            <textarea
              name="notes"
              class="textarea textarea-bordered w-full"
              rows="3"
              placeholder="Describe your condition..."
            ></textarea>
          </div>

          <!-- Submit -->
          <div class="form-control pt-4">
            <button
              type="submit"
              class="btn btn-primary w-full rounded-full shadow-md hover:shadow-lg transition"
            >
              Book Appointment
            </button>
          </div>
        </form>
      </div>
    </div>

    <%- include('./partial/_footer') %>
  </body>
</html>
