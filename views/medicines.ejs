<!DOCTYPE html>
<html lang="en">
  <%- include('./partial/_head', {title: "Medicine Lists"}) %>
  <body class="bg-gray-50 text-gray-800">

    <div class="flex justify-center min-h-screen px-4">
      <div class="flex flex-col w-full max-w-6xl mt-20">


        <div class="text-center mb-10">
          <h1 class="text-3xl font-bold mb-2 text-gray-900">
            Medicine Lists
          </h1>
          <p class="text-lg text-gray-600">
            Available medicines and their details.
          </p>
        </div>

   
        <div class="flex justify-center gap-6 mb-12 flex-wrap">
          <a
            href="/doctor/<%= UserId %>"
            class="btn bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl shadow-md w-52 py-3 transition"
          >
            Back to Doctor Page
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8 mb-10">
          <% medicines.forEach((el, i) => { %>
          <div class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition p-6">
            
            <h2 class="text-lg font-bold text-gray-900 mb-4">
              <%= i + 1 %>. <%= el.name %>
            </h2>
            <div class="space-y-2 text-sm text-gray-700">
              <p>
                <span class="font-semibold">Description:</span>
                <%= el.description %>
              </p>
              
            </div>
          </div>
          <% }) %>
        </div>

      </div>
    </div>

    <%- include('./partial/_footer') %>
  </body>
</html>
