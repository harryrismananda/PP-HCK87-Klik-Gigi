<!DOCTYPE html>
<html lang="en">
  <%- include('./partial/_head', {title: "Login"}) %>
  <body class="bg-gray-100 min-h-screen flex justify-center items-center">
    <div class="card w-96 bg-white shadow-lg rounded-2xl p-6">
      <div class="card-body">
        <h2
          class="card-title justify-center text-2xl font-bold mb-4 text-gray-900"
        >
          Login
        </h2>

        <% if (error) { %>
        <p class="text-red-500 font-medium text-center"><%= error %></p>
        <% } %>

        <form action="/user/login" method="POST" class="form-control space-y-5">
          <div>
            <label class="label">
              <span class="label-text font-medium text-gray-700">Email</span>
            </label>
            <input
              type="email"
              name="email"
              placeholder="Enter your email"
              class="input w-full bg-gray-50 text-gray-900 placeholder-gray-400 rounded-xl border border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-400 focus:outline-none transition"
            />
          </div>

          <div>
            <label class="label">
              <span class="label-text font-medium text-gray-700">Password</span>
            </label>
            <input
              type="password"
              name="password"
              placeholder="Enter your password"
              class="input w-full bg-gray-50 text-gray-900 placeholder-gray-400 rounded-xl border border-gray-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-400 focus:outline-none transition"
            />
          </div>

          <button
            type="submit"
            class="btn btn-primary w-full mt-2 rounded-xl font-medium shadow-md hover:shadow-lg transition"
          >
            Login
          </button>
        </form>

        <p class="text-center mt-6 text-sm text-gray-700">
          Don’t have an account?
          <a href="/user/register" class="link link-primary font-medium"
            >Register</a
          >
        </p>
      </div>
    </div>
  </body>
</html>
