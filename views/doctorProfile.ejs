<!DOCTYPE html>
<html lang="en">
  <%- include('./partial/_head', {title: "Doctor Profile"}) %> <%-
  include('./partial/_nav') %>
  <body class="">
    <div class="max-w-2xl mx-auto p-6">
      <h2 class="text-2xl font-bold mb-6 text-center">Doctor Profile</h2>

      <form action="/doctor/<%= user.id %>/profile" method="POST" class="space-y-6">
        <div class="card bg-base-100 shadow-xl p-6">
          <h3 class="text-lg font-semibold mb-4">General Information</h3>
          <div class="form-control mb-4">
            <label class="label">
              <span class="label-text">Full Name</span>
            </label>
            <input
              type="text"
              name="name"
              placeholder="Dr. John Doe"
              class="input input-bordered w-full"
              value="<%= user.name %>"
            />
          </div>
          <div class="form-control mb-4">
            <label class="label">
              <span class="label-text">Email</span>
            </label>
            <input
              type="email"
              name="email"
              value="<%= user.email %>"
              placeholder="doctor@email.com"
              class="input input-bordered w-full"
              disabled
            />
          </div>
        </div>

        <!-- Doctor Info -->
        <div class="card bg-base-100 shadow-xl p-6">
          <h3 class="text-lg font-semibold mb-4">Doctor Information</h3>
          <div class="form-control mb-4">
            <label class="label">
              <span class="label-text">Specialization</span>
            </label>
            <% const dentistSpecializations = ["General Dentist","Orthodontist", "Endodontist","Oral Surgeon","Pediatric Dentist","Prosthodontist","Oral Pathologist","Oral Radiologist","Cosmetic Dentist"] %>
            <select name="specialization" class="select select-bordered w-full" required>
            <option disabled selected>Select specialization</option>
            <% dentistSpecializations.forEach(spec => { %>
              <option value="<%= spec %>"><%= spec %></option>
            <% }) %>
          </select>
          </div>
          <div class="form-control mb-4">
            <label class="label">
              <span class="label-text">License Number</span>
            </label>
            <input
              type="number"
              name="licenseNumber"
              placeholder="123456"
              class="input input-bordered w-full"
              
            />
          </div>
        </div>

        <!-- Submit -->
        <div class="flex justify-center">
          <button type="submit" class="btn btn-primary">Save Profile</button>
        </div>
      </form>
    </div>
  </body>
</html>
