<!DOCTYPE html>
<html lang="en">
  <%- include('./partial/_head', {title: "Doctor Profile"}) %> 
  <%- include('./partial/_nav', {user}) %>
  <body class="bg-gray-50 text-gray-800">
    <div class="max-w-2xl mx-auto p-8 mt-16 bg-white rounded-2xl shadow-lg">
      <h2 class="text-3xl font-bold mb-8 text-center text-gray-900">Doctor Profile</h2>

      <form action="/doctor/<%= user.id %>/profile" method="POST" class="space-y-8">

        <div>
          <h3 class="text-lg font-semibold mb-4 text-gray-800">General Information</h3>
          <div class="mb-5">
            <label class="block text-sm font-medium text-gray-700 mb-2">Full Name</label>
            <input
              type="text"
              name="name"
              placeholder="Dr. John Doe"
              class="input w-full bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-400"
              value="<%= user.name %>"
            />
          </div>
          <div class="mb-5">
            <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
            <input
              type="email"
              name="email"
              value="<%= user.email %>"
              placeholder="doctor@email.com"
              class="w-full rounded-xl border-gray-300 shadow-sm px-4 py-2 bg-gray-100 text-gray-500"
              disabled
            />
          </div>
        </div>


        <div>
          <h3 class="text-lg font-semibold mb-4 text-gray-800">Doctor Information</h3>
          <div class="mb-5">
            <label class="block text-sm font-medium text-gray-700 mb-2">Specialization</label>
            <% const dentistSpecializations = ["General Dentist","Orthodontist", "Endodontist","Oral Surgeon","Pediatric Dentist","Prosthodontist","Oral Pathologist","Oral Radiologist","Cosmetic Dentist"] %>
            <select
              name="specialization"
              class="input w-full bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-400"
              required
            >
              <option disabled selected>Select specialization</option>
              <% dentistSpecializations.forEach(spec => { %>
                <option value="<%= spec %>" <%= user.Doctor.specialization === spec ? 'selected' : '' %>><%= spec %></option>
              <% }) %>
            </select>
            <% if (error) { %>
              <% error = error.split(",") %>
              <p class="text-red-500 text-sm mt-2"><%= error[0] %></p>
            <% } %>
          </div>

          <div class="mb-5">
            <label class="block text-sm font-medium text-gray-700 mb-2">License Number</label>
            <input
              type="text"
              name="licenseNumber"
              placeholder="123456"
              class="input w-full bg-white dark:bg-gray-700 text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-400"
              value="<%= user.Doctor.licenseNumber %>"
            />
            <% if (error) { %>
              <p class="text-red-500 text-sm mt-2"><%= error[0] %></p>
            <% } %>
          </div>
        </div>


        <div class="flex justify-center">
          <button
            type="submit"
            class="bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl shadow-md px-6 py-3 transition"
          >
            Save Profile
          </button>
        </div>
      </form>
    </div>
    <%- include('./partial/_footer') %>
  </body>
</html>
