<!DOCTYPE html>
<html lang="en">
  <%- include('./partial/_head', {title: "Prescription"}) %>
  <body class="bg-gray-50 text-gray-800">
    <%- include('./partial/_nav', {user}) %>

    <div class="flex justify-center min-h-screen px-4">
      <div class="flex flex-col w-full max-w-4xl mt-20">
        

        <div class="text-center mb-10">
          <h1 class="text-3xl font-bold mb-2 text-gray-900">
            Prescription for <span class="text-blue-600"><%= appointment.Patient.User.name %></span>
          </h1>
          <p class="text-lg text-gray-600">
            Appointment #<%= appointment.id %> with Dr. <%= appointment.Doctor.User.name %> on <%= appointment.scheduleFormat %>
          </p>
        </div>


        <div class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition p-8">
          <form
            action="/doctor/<%= user.id %>/appointments/<%= appointment.id %>/prescription"
            method="POST"
            class="space-y-6"
          >

            <div>
              <label class="block text-gray-700 font-semibold mb-2">Symptoms</label>
              <ul class="list-disc list-inside bg-gray-50 p-4 rounded-lg text-sm text-gray-700">
                <% appointment.Symptoms.forEach(symptom => { %>
                  <li><%= symptom.name %></li>
                <% }) %>
              </ul>
            </div>

            <div>
              <label class="block text-gray-700 font-semibold mb-2">Prescribe Medicines</label>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <% medicines.forEach(med => { %>
                  <label class="flex items-center space-x-2 p-3 border border-gray-200 rounded-lg cursor-pointer hover:bg-blue-50 transition">
                    <input
                      type="checkbox"
                      name="MedicineId"
                      value="<%= med.id %>"
                      class="checkbox checkbox-primary"
                    />
                    <span class="text-gray-800"><%= med.name %></span>
                  </label>
                <% }) %>
              </div>
            </div>

            <div>
              <label class="block text-gray-700 font-semibold mb-2">Dosage & Instructions</label>
              <textarea
                name="instruction"
                rows="3"
                class="textarea textarea-bordered w-full rounded-lg p-3 text-sm bg-gray-50"
                placeholder="e.g. Take 1 tablet after meals, 3 times a day"
              ></textarea>
            </div>
            <div>
              <button 
                type="submit" 
                class="w-full py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl shadow-md transition"
              >
                Save Prescription
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    <%- include('./partial/_footer') %>
  </body>
</html>
