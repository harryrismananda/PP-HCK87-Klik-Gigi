<!DOCTYPE html>
<html lang="en">
  <%- include('./partial/_head', {title: "Patient Profile"}) %>
  <%- include('./partial/_nav', {user}) %>

  <body class="bg-gray-50 min-h-screen">
    <div class="max-w-3xl mx-auto p-6">
      <!-- Page Title -->
      <h2 class="text-3xl font-bold mb-8 text-center text-gray-800">Patient Profile</h2>

      <form action="/patient/<%= user.id %>/profile" method="POST" class="space-y-8">
        <!-- General Info Card -->
        <div class="card bg-white shadow-md rounded-2xl p-6 border border-gray-100">
          <h3 class="text-xl font-semibold mb-6 text-primary">General Information</h3>
          
          <div class="form-control mb-5">
            <label class="label">
              <span class="label-text font-medium text-gray-700">Full Name</span>
            </label>
            <input
              type="text"
              name="name"
              placeholder="Dr. John Doe"
              class="input input-bordered w-full rounded-lg focus:ring-2 focus:ring-primary"
              value="<%= user.name %>"
            />
          </div>

          <div class="form-control mb-5">
            <label class="label">
              <span class="label-text font-medium text-gray-700">Email</span>
            </label>
            <input
              type="email"
              name="email"
              value="<%= user.email %>"
              placeholder="doctor@email.com"
              class="input input-bordered w-full rounded-lg bg-gray-100 text-gray-500"
              disabled
            />
          </div>
        </div>

        <!-- Patient Info Card -->
        <div class="card bg-white shadow-md rounded-2xl p-6 border border-gray-100">
          <h3 class="text-xl font-semibold mb-6 text-primary">Patient Information</h3>

          <!-- Gender -->
          <div class="form-control mb-5">
            <label class="label">
              <span class="label-text font-medium text-gray-700">Gender</span>
            </label>
            <% const gender = ["Male", "Female"] %>
            <select name="gender" class="select select-bordered w-full rounded-lg focus:ring-2 focus:ring-primary">
              <option disabled selected>Select gender</option>
              <% gender.forEach(el => { %>
                <option value="<%= el %>" <%= user.Patient.gender === el ? 'selected': '' %>><%= el %></option>
              <% }) %>
            </select>
            <% if (error) { %>
              <% error = error.split(",") %>
              <p class="text-red-500 text-sm mt-1"><%= error[0]  %></p>
            <% } %>
          </div>

          <!-- Age -->
          <div class="form-control mb-5">
            <label class="label">
              <span class="label-text font-medium text-gray-700">Age</span>
            </label>
            <input
              type="number"
              name="age"
              placeholder="25"
              class="input input-bordered w-full rounded-lg focus:ring-2 focus:ring-primary"
              value="<%= user.Patient.age %>"
            />
            <% if (error) { %>
              <p class="text-red-500 text-sm mt-1"><%= error[1]  %></p>
            <% } %>
          </div>

          <!-- Blood Type -->
          <div class="form-control mb-5">
            <label class="label">
              <span class="label-text font-medium text-gray-700">Blood Type</span>
            </label>
            <% const bloodType = ["A", "B", "AB", "O"] %>
            <select name="bloodType" class="select select-bordered w-full rounded-lg focus:ring-2 focus:ring-primary">
              <option disabled selected>Select Blood Type</option>
              <% bloodType.forEach(el => { %>
                <option value="<%= el %>" <%= user.Patient.bloodType === el ? 'selected' : '' %>><%= el %></option>
              <% }) %>
            </select>
            <% if (error) { %>
              <p class="text-red-500 text-sm mt-1"><%= error[2]  %></p>
            <% } %>
          </div>
        </div>

        <!-- Submit -->
        <div class="flex justify-center">
          <button type="submit" class="btn btn-primary px-8 rounded-full shadow-md hover:shadow-lg transition">
            Save Profile
          </button>
        </div>
      </form>
    </div>
    <%- include('./partial/_footer') %>
  </body>
</html>
