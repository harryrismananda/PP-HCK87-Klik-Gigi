<!DOCTYPE html>
<html lang="en">
  <%- include('./partial/_head', {title: "Patient Profile"}) %> <%-
  include('./partial/_nav', {user}) %>
  <body class="bg-stone-400">
    <div class="max-w-2xl mx-auto p-6">
      <h2 class="text-2xl font-bold mb-6 text-center">Doctor Profile</h2>

      <form action="/patient/<%= user.id %>/profile" method="POST" class="space-y-6">
        <div class="card bg-base-100 shadow-xl p-6">
          <h3 class="text-lg font-semibold mb-4">General Information</h3>
          <div class="form-control mb-4">
            <label class="label">
              <span class="label-text">Full Name</span>
            </label>
            <input
              type="text"
              name="name"
              placeholder="Dr. John Doe"
              class="input input-bordered w-full"
              value="<%= user.name %>"
            />
          </div>
          <div class="form-control mb-4">
            <label class="label">
              <span class="label-text">Email</span>
            </label>
            <input
              type="email"
              name="email"
              value="<%= user.email %>"
              placeholder="doctor@email.com"
              class="input input-bordered w-full"
              disabled
            />
          </div>
        </div>

        <!-- Patient Info -->
          <h3 class="text-lg font-semibold mb-4">Patient Information</h3>
              <div class="form-control mb-4">
                <label class="label">
                  <span class="label-text">Gender</span>
                </label>
                
                <% const gender = ["Male", "Female"] %>
                <select name="gender" class="select select-bordered w-full">
                  <option disabled selected>Select gender</option>
                  <% gender.forEach(el => { %>
                  <option value="<%= el %>" <%= user.Patient.gender === el ? 'selected': '' %>><%= el %></option>
                  <% }) %>
                </select>
                <% if (error) { %>
                  <% error = error.split(",") %>
                 <p class="text-red-500 font-medium"><%= error[0]  %></p>
                <% } %>

              </div>
              <div class="form-control mb-4">
                <label class="label">
                  <span class="label-text">Age</span>
                </label>
                
                <input
                  type="number"
                  name="age"
                  placeholder="123456"
                  class="input input-bordered w-full"
                  value="<%= user.Patient.age %>"
                />
                <% if (error) { %>
                  
                 <p class="text-red-500 font-medium"><%= error[1]  %></p>
                <% } %>
              </div>
              <div class="form-control mb-4">
                <label class="label">
                  <span class="label-text">Blood Type</span>
                </label>
              
                <% const bloodType = ["A", "B", "AB", "O"] %>
                <select name="bloodType" class="select select-bordered w-full">
                  <option disabled selected>Select Blood Type</option>
                  <% bloodType.forEach(el => { %>
                  <option value="<%= el %>" <%= user.Patient.bloodType === el  ? 'selected' : '' %>><%= el %></option>
                  <% }) %>
                </select>
                 <% if (error) { %>
                  
                 <p class="text-red-500 font-medium"><%= error[2]  %></p>
                <% } %>
              </div>
            

        <!-- Submit -->
        <div class="flex justify-center">
          <button type="submit" class="btn btn-primary">Save Profile</button>
        </div>
      </form>
    </div>
    <%- include('./partial/_footer') %>
  </body>
</html>
