<!DOCTYPE html>
<html lang="en">
  <%- include('./partial/_head', {title: "Home"}) %> <%-
  include('./partial/_nav', {user}) %>
  <body class="bg-gray-50 text-gray-800">
    <div class="flex justify-center min-h-screen px-4">
      <div class="flex flex-col w-full max-w-6xl mt-20">
        <div class="text-center mb-10">
          <h1 class="text-3xl font-bold mb-2 text-gray-900">
            Welcome, Dr. <span class="text-blue-600"><%= user.name %></span>
          </h1>
        </div>

        <div class="flex justify-center gap-6 mb-12 flex-wrap">
          <a
            href="/doctor/medicines"
            class="btn bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl shadow-md w-52 py-3 transition"
          >
            View Medicine Lists
          </a>
          <a
            href="/doctor/<%= user.id %>/profile"
            class="btn bg-pink-500 hover:bg-pink-600 text-white font-semibold rounded-xl shadow-md w-52 py-3 transition"
          >
            Edit Profile
          </a>
        </div>

        <div class="overflow-x-auto max-w">
          <% if (msg) { %>
          <div class="toast toast-end z-50">
            <div class="alert alert-success shadow-lg">
              <div>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="stroke-current shrink-0 h-6 w-6"
                  fill="none"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M5 13l4 4L19 7"
                  />
                </svg>
                <span><%= msg %></span>
              </div>
              <a
                href="/doctor/<%= user.id %>"
                class="btn btn-sm btn-ghost absolute top-1 right-1"
              >
                ✕
              </a>
            </div>
          </div>

          <% } %>
          <div class="mb-5">
            <form action="/doctor/<%= user.id %>" method="get" class="flex items-center gap-2">
              <input
                type="text"
                name="search"
                placeholder="Search by patient"
                class="input input-bordered w-64 bg-white text-black  dark:bg-gray-600 dark:text-white dark:placeholder-gray-400 rounded-l-lg"
              />
              <input
                type="submit"
                value="search"
                 class="h-10 px-4 bg-blue-600 text-white font-bold rounded-r-lg hover:bg-blue-700 transition"
              />
            </form>
          </div>

          <table class="table w-full">
           
            <thead>
              <tr class="bg-base-300">
                <th>Patient</th>
                <th>Appointment Date</th>
                <th>Status</th>
                <th>Symptoms</th>
                <th>Notes</th>
                <th class="text-center">Action</th>
              </tr>
            </thead>
            
            <tbody>
              <% appointments.forEach(el => { %>
              <tr class="hover:bg-blue-300">
                <td><%= el.Patient.User.name %></td>
                <td><%= el.scheduleFormat %></td>
                <td><%= el.status ?'Approved' : 'Pending' %></td>
                <td>
                  <label
                    for="my_modal_<%= el.id %>"
                    class="btn btn-outline btn-primary font-bold text-dark"
                    >Symptoms</label
                  >

                  <input
                    type="checkbox"
                    id="my_modal_<%= el.id %>"
                    class="modal-toggle"
                  />
                  <div class="modal" role="dialog">
                    <div class="modal-box">
                      <h3 class="font-bold text-lg dark:text-white">
                        Symptom List:
                      </h3>
                      <p
                        class="space-y-2 text-sm text-gray-700 dark:text-white"
                      >
                        <% el.Symptoms.forEach((element, i) => { %> <%= i !==
                        el.Symptoms.length -1 ? `${element.name}, `:
                        element.name %> <% }) %>
                      </p>
                      <div class="modal-action">
                        <label for="my_modal_<%= el.id %>" class="btn"
                          >Close</label
                        >
                      </div>
                    </div>
                  </div>
                </td>
                <td><%= el.notes %></td>
                <td class="space-y-2 sm:space-y-0 sm:space-x-2 flex flex-col sm:flex-row">
                  <% if (el.status) { %>
                  <a
                    href="/doctor/<%= user.id %>/appointments/<%= el.id %>/prescription"
                    class="btn btn-sm btn-primary font-semibold rounded-lg shadow-md w-full sm:w-auto text-center"
                  >
                    Create Prescription
                  </a>
                  <% } else { %>
                  <a
                    href="/doctor/<%= user.id %>/appointments/<%= el.id %>/approve"
                    class="btn btn-sm btn-accent font-semibold rounded-lg shadow-md w-full sm:w-auto text-center"
                  >
                    Approve Appointment
                  </a>

                  <a
                    href="/doctor/<%= user.id %>/appointments/<%= el.id %>/delete"
                    class="btn btn-sm btn-error font-semibold rounded-lg shadow-md w-full sm:w-auto text-center"
                  >
                    Delete Appointment
                  </a>
                  <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <%- include('./partial/_footer') %>
  </body>
</html>
