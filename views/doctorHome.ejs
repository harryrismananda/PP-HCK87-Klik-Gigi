<!DOCTYPE html>
<html lang="en">
  <%- include('./partial/_head', {title: "Home"}) %> <%-
  include('./partial/_nav', {user}) %>
  <body class="bg-stone-400">
    <div class="flex justify-center items-center">
      <div class="flex flex-col items-center justify-center mt-10 px-4 w-full">
        <h1 class="text-3xl font-bold mb-6">
          Welcome, Dr. <%= user.name %> 🦷
        </h1>

        <!-- View Patients Button -->
         <div class="grid grid-cols-2 gap-5">
           <a href="/doctor/medicines" class="btn btn-primary mb-8"> View Medicine Lists </a>
           <a href="/doctor/<%= user.id %>/profile" class="btn btn-primary mb-8">
             Edit Profile
           </a>

         </div>

        <!-- Appointment Table -->
        <div class="overflow-x-auto max-w">
          <table class="table w-full ">
            <!-- Table Head -->
            <thead >
              <tr class="bg-base-300">
                <th>Patient</th>
                <th>Date</th>
                <th>Status</th>
                <th>Symptoms</th>
                <th>Notes</th>
                <th class="text-center">Action</th>
              </tr>
            </thead>
            <!-- Table Body -->
            <tbody>
              <% appointments.forEach(el => { %>
              <tr class="hover:bg-blue-300">
                <td><%= el.Patient.User.name %></td>
                <td><%= el.scheduleFormat %></td>
                <td><%= el.status ?'Approved' : 'Pending' %></td>
                <td>
                  <label for="my_modal_5" class="btn btn-outline btn-primary font-bold text-dark">Symptoms</label>

                  <input type="checkbox" id="my_modal_5" class="modal-toggle" />
                  <div class="modal" role="dialog">
                    <div class="modal-box">
                      <h3 class="font-bold text-lg">Symptom List</h3>
                      <p class="py-4">
                         <% el.Symptoms.forEach((symptom, i) => { %> 
                          <%= i  !== el.Symptoms.length -1 ? `${symptom.name},  `: symptom.name %> 
                         <%  }) %>
                      </p>
                      <div class="modal-action">
                        <label for="my_modal_5" class="btn">Close</label>
                      </div>
                    </div>
                  </div>

                 
                </td>
                <td><%= el.notes %></td>
                <td class="">
                  <a
                    href="/doctor/<%= user.id %>/appointments/<%= el.id %>/approve"
                    class="btn btn-sm btn-accent"
                  >
                    Approve Appointment
                  </a>
                  
                  <a
                    href="/doctor/<%= user.id %>/appointments/<%= el.id %>/delete"
                    class="btn btn-sm btn-error"
                  >
                    Delete Appointment
                  </a>
                  <% if (el.status) { %>
                  <a
                    href="/doctor/<%= user.id %>/appointments/<%= el.id %>/prescription"
                    class="btn btn-sm btn-primary font-bold"
                  >
                    Create Prescription
                  </a>
                  <% } %>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </body>
  <%- include('./partial/_footer') %>
</html>
