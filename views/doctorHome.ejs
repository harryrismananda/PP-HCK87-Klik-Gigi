<!DOCTYPE html>
<html lang="en">
  <%- include('./partial/_head', {title: "Home"}) %> <%-
  include('./partial/_nav', {user}) %>
  <body class="bg-stone-400">
    <div class="flex justify-center items-center">
      <div class="flex flex-col items-center justify-center mt-10 px-4 w-full">
        <h1 class="text-3xl font-bold mb-6">
          Welcome, Dr. <%= user.name %> 🦷
        </h1>

        <!-- View Patients Button -->
        <a href="/patients" class="btn btn-primary mb-8"> View Patient List </a>
        <a href="/doctor/<%= user.id %>/profile" class="btn btn-primary mb-8"> Edit Profile </a>

        <!-- Appointment Table -->
        <div class="overflow-x-auto w-full max-w-5xl">
          <table class="table table-zebra w-full">
            <!-- Table Head -->
            <thead>
              <tr>
                <th>Patient</th>
                <th>Date</th>
                <th>Time</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <!-- Table Body -->
            <tbody>
              <tr>
                <td>John Doe</td>
                <td>2025-08-25</td>
                <td>10:00 AM</td>
                <td>Pending</td>
                <td>
                  <a href="/appointments/1/edit" class="btn btn-sm btn-accent">
                    Update Status
                  </a>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <%- include('./partial/_footer') %>
  </body>
</html>
