<!DOCTYPE html>
<html lang="en">
  <%- include('./partial/_head', {title: "Admin Register"}) %>
  <body class="">
    <div class="flex justify-center items-center">
      <div class="card w-96 bg-base-100 shadow-xl py-20 my-10">
        <div class="card-body">
          <h2 class="card-title justify-center">Register for Doctor</h2>

          <form
            action="/user/reg-admin"
            method="POST"
            class="form-control space-y-4"
          >
            <div>
              <label class="label">
                <span class="label-text">Full Name</span>
              </label>
              <input
                type="text"
                name="name"
                placeholder="Enter your full name"
                class="input input-bordered w-full"
              />
            </div>

            <div>
              <label class="label">
                <span class="label-text">Email</span>
              </label>
              <input
                type="email"
                name="email"
                placeholder="Enter your email"
                class="input input-bordered w-full"
              />
            </div>

            <div>
              <label class="label">
                <span class="label-text">Password</span>
              </label>
              <input
                type="password"
                name="password"
                placeholder="Enter your password"
                class="input input-bordered w-full"
              />
            </div>

            <div>
              <label class="label">
                <span class="label-text">Confirm Password</span>
              </label>
              <input
                type="password"
                name="confirmPassword"
                placeholder="Confirm your password"
                class="input input-bordered w-full"
                required
              />
            </div>
            <% if (error) { %>
            <p class="text-red-500"><%= error %></p>
            <% } %>

            <div class="card bg-base-100 shadow-xl p-6">
              <h3 class="text-lg font-semibold mb-4">Doctor Information</h3>
              <div class="form-control mb-4">
                <label class="label">
                  <span class="label-text">Specialization</span>
                </label>
                <% const dentistSpecializations = ["General Dentist","Orthodontist", "Endodontist","Oral Surgeon","Pediatric Dentist","Prosthodontist","Oral Pathologist","Oral Radiologist","Cosmetic Dentist"] %>
                <select
                  name="specialization"
                  class="select select-bordered w-full"
                  
                >
                  <option disabled selected>Select specialization</option>
                  <% dentistSpecializations.forEach(spec => { %>
                  <option value="<%= spec %>"><%= spec %></option>
                  <% }) %>
                </select>
              </div>
              <div class="form-control mb-4">
                <label class="label">
                  <span class="label-text">License Number</span>
                </label>
                <input
                  type="number"
                  name="licenseNumber"
                  placeholder="123456"
                  class="input input-bordered w-full"
                />
              </div>
            </div>

            <button type="submit" class="btn btn-primary w-full">
              Register
            </button>
          </form>

          <p class="text-center mt-4 text-sm">
            Already have an account?
            <a href="/user/login" class="link link-primary">Login</a>
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
